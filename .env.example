# STRIDE optional cloud sync (Supabase). Leave unset to run fully local-first.
# These are safe to expose in the browser (anon / publishable key) but are kept
# out of git. For the GitHub Pages build, set them as repo secrets of the same name.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base path for deployment (GitHub Pages serves under /<repo>/). Local dev uses /.
# VITE_BASE=/PGymAi/
